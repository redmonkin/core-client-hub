# Frontend configuration (copy to .env). All VITE_* values are embedded in the
# browser bundle, so never put a secret here.

# Supabase project: Project Settings > API
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon / publishable key>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# Public origin of this deployment, no trailing slash. Used for canonical and
# Open Graph tags, sitemap.xml and robots.txt.
VITE_SITE_URL="https://clientra.example.com"

# Source repository linked from the landing page (optional; defaults to upstream).
# VITE_REPO_URL="https://github.com/<you>/clientra"

# Local dev server port
PORT=8080
