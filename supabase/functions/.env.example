# Edge function secrets. Set them on your project with:
#   supabase secrets set --env-file supabase/functions/.env
# (copy this file to supabase/functions/.env first; it is git-ignored).
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided to
# every function automatically by Supabase and don't need to be set.

# Resend API key (https://resend.com), used by every function that sends email.
RESEND_API_KEY="re_..."

# Sender address for all outgoing email. Must be on a domain verified in Resend.
EMAIL_FROM_ADDRESS="noreply@notifications.example.com"

# Public URL of the frontend, no trailing slash. Required: the cron jobs use it
# to build client-portal links, and the send-*-email functions only allow email
# buttons that link to this origin (any link is accepted if it is unset).
APP_URL="https://clientra.example.com"
